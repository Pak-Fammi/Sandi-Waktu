<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sandi Waktu - Mockup</title>
    <style>
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: #1e272e; 
            color: #d2dae2; 
            text-align: center; 
            margin: 0; 
            padding: 20px; 
        }
        .container { 
            background: #2d3436; 
            padding: 30px; 
            border-radius: 12px; 
            box-shadow: 0 8px 16px rgba(0,0,0,0.5); 
            max-width: 400px; 
            margin: 40px auto; 
        }
        h1 { color: #0fb9b1; }
        input { 
            padding: 12px; 
            margin: 10px 0; 
            width: 85%; 
            border-radius: 6px; 
            border: 1px solid #576574; 
            background-color: #222f3e;
            color: white;
        }
        button { 
            padding: 12px; 
            margin: 10px 0; 
            width: 90%; 
            font-size: 16px; 
            font-weight: bold;
            background-color: #0fb9b1; 
            color: #1e272e; 
            border: none; 
            cursor: pointer; 
            border-radius: 6px; 
            transition: 0.3s;
        }
        button:hover { background-color: #2bcbba; }
        .hidden { display: none; }
        .role-card {
            background-color: #ff9f43;
            color: #222f3e;
            padding: 15px;
            border-radius: 8px;
            margin: 20px 0;
            font-weight: bold;
        }
        .chat-box {
            background-color: #222f3e;
            height: 150px;
            border-radius: 8px;
            margin-bottom: 10px;
            border: 1px solid #576574;
            padding: 10px;
            text-align: left;
            overflow-y: auto;
            color: #c8d6e5;
        }
    </style>
</head>
<body>

    <!-- HALAMAN 1: MENU UTAMA -->
    <div class="container" id="menu-screen">
        <h1>Sandi Waktu ⏳</h1>
        <p>Temukan penyusup di ruang waktu!</p>
        
        <input type="text" id="playerName" placeholder="Ketik Namamu..." required>
        <br>
        <button id="btnCreateRoom">Buat Room Baru</button>
        
        <hr style="border-color: #576574; margin: 20px 0;">
        
        <input type="text" id="roomCode" placeholder="Kode Room (misal: SANDI)">
        <br>
        <button id="btnJoinRoom" style="background-color: #48dbfb;">Gabung ke Room</button>
    </div>

    <!-- HALAMAN 2: LOBBY -->
    <div class="container hidden" id="lobby-screen">
        <h2 style="color: #48dbfb;">Room: <span id="displayCode">SANDI-123</span></h2>
        <p>Pemain yang siap:</p>
        <ul style="text-align: left; background: #222f3e; padding: 15px; border-radius: 8px; list-style-type: none;">
            <li>👤 <span id="hostName">Kamu</span> (Host)</li>
            <li>👤 Pemain 2 (Menunggu...)</li>
            <li>👤 Pemain 3 (Menunggu...)</li>
        </ul>
        <button id="btnStartGame" style="background-color: #ff9f43;">Mulai Permainan</button>
    </div>

    <!-- HALAMAN 3: ARENA BERMAIN (Contoh Fase Debat) -->
    <div class="container hidden" id="game-screen">
        <h2>Fase Debat Waktu ⏱️</h2>
        
        <div class="role-card">
            Peranmu: DETEKTIF WAKTU 🕵️
        </div>

        <div class="chat-box">
            <em>Sistem: Selesaikan teka-teki untuk membuka petunjuk.</em><br>
            <strong>Kamu:</strong> Saya rasa penyusupnya ada di antara kita!<br>
        </div>

        <input type="text" placeholder="Ketik pesan..." style="width: 70%; display: inline-block;">
        <button style="width: 20%; display: inline-block; padding: 12px 5px;">Kirim</button>
        
        <button id="btnBackToMenu" style="background-color: #ee5253; margin-top: 20px;">Kembali ke Menu</button>
    </div>

    <!-- LOGIKA PERPINDAHAN HALAMAN -->
    <script>
        // Mengambil elemen HTML
        const menuScreen = document.getElementById("menu-screen");
        const lobbyScreen = document.getElementById("lobby-screen");
        const gameScreen = document.getElementById("game-screen");
        
        const btnCreateRoom = document.getElementById("btnCreateRoom");
        const btnStartGame = document.getElementById("btnStartGame");
        const btnBackToMenu = document.getElementById("btnBackToMenu");
        const hostNameSpan = document.getElementById("hostName");
        const playerNameInput = document.getElementById("playerName");

        // Simulasi Klik Buat Room -> Pindah ke Lobby
        btnCreateRoom.addEventListener("click", () => {
            if(!playerNameInput.value) {
                alert("Isi namamu dulu!");
                return;
            }
            hostNameSpan.innerText = playerNameInput.value;
            menuScreen.classList.add("hidden");
            lobbyScreen.classList.remove("hidden");
        });

        // Simulasi Klik Mulai Game -> Pindah ke Arena Bermain
        btnStartGame.addEventListener("click", () => {
            lobbyScreen.classList.add("hidden");
            gameScreen.classList.remove("hidden");
        });

        // Kembali ke awal
        btnBackToMenu.addEventListener("click", () => {
            gameScreen.classList.add("hidden");
            menuScreen.classList.remove("hidden");
            playerNameInput.value = "";
        });
    </script>
</body>
</html>
