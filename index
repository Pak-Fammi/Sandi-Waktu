<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sandi Waktu - Digital Social Deduction</title>
    <style>
        body { font-family: Arial, sans-serif; text-align: center; margin-top: 50px; background-color: #f4f4f9; }
        .container { background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); display: inline-block; }
        input, button { padding: 10px; margin: 10px 0; width: 80%; font-size: 16px; }
        button { background-color: #2c3e50; color: white; border: none; cursor: pointer; border-radius: 5px; }
        button:hover { background-color: #1a252f; }
        .hidden { display: none; }
    </style>
</head>
<body>

    <div class="container" id="menu-screen">
        <h1>Sandi Waktu</h1>
        <p>Temukan penyusup di ruang waktu!</p>
        
        <input type="text" id="playerName" placeholder="Masukkan Namamu" required>
        <br>
        <button id="btnCreateRoom">Buat Room Baru (Host)</button>
        
        <hr>
        
        <input type="text" id="roomCode" placeholder="Kode Room (Contoh: SANDI-123)">
        <br>
        <button id="btnJoinRoom">Gabung ke Room</button>
    </div>

    <div class="container hidden" id="lobby-screen">
        <h2>Lobby: <span id="displayRoomCode"></span></h2>
        <p>Pemain yang tergabung:</p>
        <ul id="playerList" style="text-align: left;"></ul>
        <p><em>Menunggu Host memulai permainan...</em></p>
    </div>

   <script type="module">
        // Menggunakan impor dari CDN untuk HTML biasa
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
        import { getFirestore, doc, setDoc } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

        // Konfigurasi Firebase asli milikmu
        const firebaseConfig = {
            apiKey: "AIzaSyDffAhILamwybmkxw_KtkN5Kn8gpNmDocA",
            authDomain: "sandi-waktu.firebaseapp.com",
            projectId: "sandi-waktu",
            storageBucket: "sandi-waktu.firebasestorage.app",
            messagingSenderId: "909497128733",
            appId: "1:909497128733:web:55be61bfe0a3b37b39f3f4"
        };

        // Inisialisasi Firebase
        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);

        // Ambil elemen dari HTML
        const btnCreateRoom = document.getElementById("btnCreateRoom");
        const playerNameInput = document.getElementById("playerName");

        // Logika saat tombol Buat Room diklik
        btnCreateRoom.addEventListener("click", async () => {
            const playerName = playerNameInput.value;
            
            if (!playerName) {
                alert("Tulis namamu dulu ya sebelum membuat room!");
                return;
            }

            // Buat kode room acak (Contoh: SANDI-X7A)
            const randomStr = Math.random().toString(36).substring(2, 5).toUpperCase();
            const newRoomCode = `SANDI-${randomStr}`;

            try {
                // A. Menyimpan data Room ke Firestore
                const roomRef = doc(db, "rooms", newRoomCode);
                await setDoc(roomRef, {
                    status: "lobby",
                    host: playerName,
                    createdAt: new Date()
                });

                // B. Menyimpan pembuat room (Host) sebagai pemain pertama
                const playerRef = doc(db, `rooms/${newRoomCode}/players`, playerName);
                await setDoc(playerRef, {
                    name: playerName,
                    role: "belum_ditentukan", 
                    isAlive: true,
                    hasClue: false
                });

                alert(`Room berhasil dibuat! Kode kamu: ${newRoomCode}`);
                console.log("Data berhasil dikirim. Cek Firestore kamu sekarang!");
                
            } catch (error) {
                console.error("Error membuat room: ", error);
                alert("Gagal membuat room. Silakan cek console browser (F12) untuk detailnya.");
            }
        });
    </script>
</body>
</html>
